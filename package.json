{
  "name": "pcf2ttf",
  "version": "1.0.0",
  "description": "Convert PCF bitmap fonts to TrueType pixel outlines",
  "type": "module",
  "main": "./build/index.js",
  "types": "./build/index.d.ts",
  "exports": {
    ".": {
      "types": "./build/index.d.ts",
      "import": "./build/index.js"
    }
  },
  "bin": {
    "pcf2ttf": "./build/cli.js"
  },
  "files": [
    "build",
    "README.md"
  ],
  "engines": {
    "node": ">=22.13.0"
  },
  "packageManager": "pnpm@11.16.0",
  "scripts": {
    "dev": "tsx src/cli.ts",
    "build": "tsc",
    "start": "node build/cli.js",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.test.json",
    "lint": "biome check .",
    "format": "biome check --write .",
    "test": "pnpm build && tsx --test test/*.test.ts",
    "prepack": "pnpm build"
  },
  "license": "GPL",
  "dependencies": {
    "fonteditor-core": "^2.6.3"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.13",
    "@types/node": "^24.13.4",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2"
  }
}
